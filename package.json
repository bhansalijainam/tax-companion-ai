{
  "name": "tax-companion-ai",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "tsx scripts/run-evals.ts",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.app.json --noEmit",
