# Live AI mode (server-side only — never exposed to the browser).
# Without these, the app runs in demo mode (rules extractor + scripted assistant).
ANTHROPIC_API_KEY=

# Practice workspace (sign-in, client list, server-saved cases). Leave unset for demo-only.
# DATABASE_URL=                    # Postgres (Neon via Vercel Marketplace sets this)
# BETTER_AUTH_SECRET=              # 32+ random characters: openssl rand -base64 32
# BETTER_AUTH_URL=                 # production domain only; leave unset on previews

# Optional
# LLM_PROVIDER=anthropic          # provider adapter (see server/handlers.ts)
# LLM_MODEL=claude-opus-5-5       # model id
# ACCESS_TOKEN=                   # if set, live endpoints require header x-access-token
# RATE_LIMIT_PER_MIN=30           # per-IP limit on /api/extract and /api/chat (0 disables)
# EXTRACTION_STRATEGY=llm         # llm | hybrid (rules first, LLM only when rules miss required fields)
